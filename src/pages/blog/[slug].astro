---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getAllPosts, type BlogPost } from '../../content/blog/config';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();

  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts },
  }));
}

export interface Props {
  post: BlogPost;
  allPosts: BlogPost[];
}

const { post, allPosts } = Astro.props;
const entry = await getEntry('blog', post.slug);
const { Content } = await render(entry!);

const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.category && p.category === post.category)
  .slice(0, 3);

const canonical = post.canonical || undefined;
---

<BlogLayout post={post} canonical={canonical}>
  <Content />

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2 class="related-heading">Related Posts</h2>
      <div class="related-list">
        {relatedPosts.map((related) => (
          <a class="related-card" href={`/blog/${related.slug}/`}>
            <p class="related-card-title">{related.title}</p>
            <p class="related-card-excerpt">{related.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <nav class="post-nav" aria-label="Blog post navigation">
    {prevPost ? (
      <a class="post-nav-link prev" href={`/blog/${prevPost.slug}/`}>
        <span class="post-nav-direction">&larr; Previous</span>
        <span class="post-nav-title">{prevPost.title}</span>
      </a>
    ) : (
      <span />
    )}
    {nextPost ? (
      <a class="post-nav-link next" href={`/blog/${nextPost.slug}/`}>
        <span class="post-nav-direction">Next &rarr;</span>
        <span class="post-nav-title">{nextPost.title}</span>
      </a>
    ) : (
      <span />
    )}
  </nav>
</BlogLayout>

<style>
  .related-posts {
    border-top: 1px solid var(--color-light-gray);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .related-heading {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }

  .related-list {
    display: grid;
    gap: 1rem;
  }

  .related-card {
    border: 1px solid var(--color-light-gray);
    border-radius: 8px;
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease;
  }

  .related-card:hover {
    background: var(--color-off-white);
    border-color: var(--color-green);
  }

  .related-card-title {
    color: var(--color-deep-green);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem;
  }

  .related-card-excerpt {
    color: var(--color-mid-gray);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  .post-nav {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr 1fr;
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .post-nav-link {
    border: 1px solid var(--color-light-gray);
    border-radius: 8px;
    display: block;
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  .post-nav-link:hover {
    border-color: var(--color-green);
  }

  .post-nav-link.next {
    text-align: right;
  }

  .post-nav-direction {
    color: var(--color-green);
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }

  .post-nav-title {
    color: var(--color-charcoal);
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
</style>
