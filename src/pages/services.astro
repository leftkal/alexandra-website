---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Photography Guides in Athens | Alexandra Maria Deli';
const description = 'Photography guides by Alexandra Maria Deli have moved to /guides/.';
---

<BaseLayout title={title} description={description} canonical="https://alexandra-maria-deli.gr/guides/">
  <meta http-equiv="refresh" content="0; url=/guides/" slot="head" />
  <meta name="robots" content="noindex, follow" slot="head" />
  <main class="redirect-page">
    <section class="redirect-content">
      <p class="eyebrow">Guides</p>
      <h1>Photography Guides</h1>
      <p>This page has moved to <a href="/guides/">/guides/</a>.</p>
      <a class="button" href="/guides/">View guides</a>
    </section>
  </main>

  <script is:inline>
    window.location.replace('/guides/');
  </script>
</BaseLayout>

<style>
  .redirect-page {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 3rem);
  }

  .redirect-content {
    max-width: 42rem;
    text-align: center;
  }

  .redirect-content p:not(.eyebrow) {
    color: color-mix(in srgb, var(--color-charcoal) 78%, var(--color-mid-gray));
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    margin: 1rem 0 1.6rem;
  }

  .redirect-content a:not(.button) {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
