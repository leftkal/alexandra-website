---
import '../styles/global.css';
import { albums, getAlbumImagePath, getAlbumUrl } from '../content/albums';
import { landingPages } from '../content/landing-pages';
import { getPageUrl } from '../utils/url';

const albumPreviewLimit = 10;
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
const siteUrl = 'https://alexandra-maria-deli.gr/';
const previewImage = `${siteUrl}images/presence-behind-the-door/R1-00324-0018.jpg`;
const pageTitle = 'Alexandra Maria Deli | Photographer in Athens';
const pageDescription = 'Portfolio of Alexandra Maria Deli, an Athens-based photographer working with travel, analog process, portraiture, and visual storytelling.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}#alexandra-maria-deli`,
  name: 'Alexandra Maria Deli',
  jobTitle: 'Photographer',
  description: pageDescription,
  url: siteUrl,
  image: previewImage,
  sameAs: ['https://www.instagram.com/daleria_xplorelens/'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Athens',
    addressCountry: 'GR',
  },
  knowsAbout: [
    'Photography',
    'Analog photography',
    'Darkroom printing',
    'Travel photography',
    'Studio photography',
    'Photo editing',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content="Black-and-white photograph by Alexandra Maria Deli" />
    <meta property="og:site_name" content="Alexandra Maria Deli" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={previewImage} />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header" aria-label="Main navigation">
      <a class="brand" href="#top">Alexandra Maria Deli</a>
      <nav>
        <a href="#top">Home</a>
        <a href="#work">Albums</a>
        <a href="#about">About</a>
        <a href="#guides">Guides</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Travel / Analog / Stories</p>
          <h1 id="hero-title">Visual stories shaped by light, travel, and film.</h1>
          <p class="hero-text">
            Alexandra Maria Deli follows quiet traces of place, memory, and light,
            creating photographs with a natural, observant rhythm.
          </p>
          <a class="button" href="#work">View albums</a>
        </div>
        <figure class="hero-image">
          <img
            src={asset('images/presence-behind-the-door/R1-00324-0018.jpg')}
            alt="Featured photograph by Alexandra Maria Deli"
          />
        </figure>
      </section>

      <section class="intro" aria-label="Portfolio introduction">
        <div class="intro-copy">
          <p>
            Passionate about photography as a visual journey, Alexandra combines a
            fresh perspective with hands-on darkroom practice, studio experience,
            and careful post-production.
          </p>
        </div>
        <div class="focus-wheel" data-focus-wheel aria-hidden="true">
          <span class="focus-wheel-ring outer"></span>
          <span class="focus-wheel-ring middle"></span>
          <span class="focus-wheel-ring inner"></span>
          <span class="focus-wheel-tick major"></span>
          <span class="focus-wheel-tick minor one"></span>
          <span class="focus-wheel-tick minor two"></span>
          <span class="focus-wheel-tick minor three"></span>
          <span class="focus-wheel-pointer"></span>
          <svg class="focus-wheel-label" viewBox="0 0 200 200" aria-hidden="true">
            <defs>
              <path id="focus-label-arc" d="M 72 104 A 28 28 0 0 0 128 104" />
            </defs>
            <text>
              <textPath href="#focus-label-arc" startOffset="50%" text-anchor="middle">Manual Focus</textPath>
            </text>
          </svg>
        </div>
      </section>

      <section id="work" class="work" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow">Selected Work</p>
          <h2 id="work-title">Albums</h2>
        </div>

        <div class="album-shell" data-album-carousel>
          {albums.length > 1 && (
            <div class="album-controls" aria-label="Album controls">
              <button class="album-arrow" type="button" data-album-prev aria-label="Previous album">&larr;</button>
              <div class="album-dots" role="tablist" aria-label="Choose album">
                {albums.map((album, index) => (
                  <button
                    class:list={['album-dot', index === 0 && 'active']}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls={album.slug}
                    data-album-dot={index}
                  >
                    {album.title}
                  </button>
                ))}
              </div>
              <button class="album-arrow" type="button" data-album-next aria-label="Next album">&rarr;</button>
            </div>
          )}

          <div class="albums" tabindex="0" aria-live="polite">
            {albums.map((album, albumIndex) => (
              <article class:list={['album', albumIndex === 0 && 'active']} id={album.slug} data-album-panel={albumIndex} aria-hidden={albumIndex === 0 ? 'false' : 'true'}>
              <div class="album-heading">
                <div>
                  <p class="eyebrow">{album.photos.length} photographs</p>
                  <h3>{album.title}</h3>
                </div>
                <p>{album.description}</p>
              </div>

              <div class="gallery">
                {album.photos.slice(0, albumPreviewLimit).map((photo, index) => (
                  <button
                    class:list={['gallery-item', index % 5 === 0 && 'wide', index % 7 === 0 && 'tall']}
                    type="button"
                    data-lightbox-trigger
                    data-lightbox-album={albumIndex}
                    data-lightbox-index={index}
                    data-lightbox-src={asset(getAlbumImagePath(album, photo))}
                    data-lightbox-title={album.title}
                  >
                    <img src={asset(getAlbumImagePath(album, photo))} alt={`${album.title} photograph ${index + 1}`} loading={index < 3 ? 'eager' : 'lazy'} />
                  </button>
                ))}
              </div>
              {album.photos.length > albumPreviewLimit && (
                <div class="album-actions">
                  <a class="button secondary" href={getAlbumUrl(album.slug)}>View full album</a>
                </div>
              )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="about" aria-labelledby="about-title">
        <figure>
          <img src={asset('images/profile_pic.jpg')} alt="Portrait of Alexandra Maria Deli" loading="lazy" />
        </figure>
        <div>
          <p class="eyebrow">Behind the Lens</p>
          <h2 id="about-title">A quiet practice between travel, film, and atmosphere.</h2>
          <p>
            Alexandra is an Athens-based photographer whose work moves between
            travel, analog process, and intimate observation. Her images often begin
            with small thresholds: a wall, a door, a shadow, a fragment of landscape.
          </p>
          <p>
            Her background includes darkroom work, studio practice, and photographic
            studies in Berlin. She approaches each frame with patience, restraint,
            and attention to atmosphere.
          </p>
          <p class="bio-note">
            Selected background: analog lab practice, photography studies in Berlin,
            and the black-and-white project
            <em>The Presence Behind the Door</em>.
          </p>
        </div>
      </section>

      <section id="guides" class="services-preview" aria-labelledby="guides-preview-title">
        <div class="section-heading">
          <p class="eyebrow">Guides</p>
          <h2 id="guides-preview-title">Photography guides</h2>
        </div>

        <div class="services-preview-row" aria-label="Selected photography guides">
          {landingPages.slice(0, 6).map((page) => (
            <a class="services-preview-card" href={getPageUrl(page.slug)}>
              <h3>{page.title}</h3>
              <p>{page.metaDescription}</p>
              <strong>Read guide &rarr;</strong>
            </a>
          ))}
        </div>
        <div class="services-preview-actions">
          <a class="button secondary" href="/guides/">View all guides</a>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">For projects, prints, and collaborations in Athens and beyond.</h2>
          <p>Share a few details about the project, location, and timing.</p>
          <a class="button secondary" href="https://www.instagram.com/daleria_xplorelens/" target="_blank" rel="noreferrer nofollow">
            Instagram
          </a>
        </div>
        <form class="contact-form" action="https://turnstile-worker.leftkal.workers.dev" method="POST" data-contact-form>
          <input type="hidden" name="_subject" value="Photography inquiry from alexandra-maria-deli.gr" />
          <label>
            Name
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            Contact email
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            Project
            <textarea name="message" rows="5" required></textarea>
          </label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAADmmpbZjPtxnJITb"></div>
          <p class="contact-form-note" data-contact-form-note hidden>Please complete the verification before sending.</p>
          <button class="button" type="submit">Send inquiry</button>
        </form>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Alexandra Maria Deli</p>
    </footer>
    <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image preview">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close preview">&times;</button>
      <button class="lightbox-nav previous" type="button" data-lightbox-prev aria-label="Previous photograph">&larr;</button>
      <figure class="lightbox-frame">
        <img data-lightbox-image alt="Selected photograph preview" />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
      <button class="lightbox-nav next" type="button" data-lightbox-next aria-label="Next photograph">&rarr;</button>
    </div>
    <script>
      const contactForm = document.querySelector('[data-contact-form]');

      contactForm?.addEventListener('submit', (event) => {
        event.preventDefault();

        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement)) return;

        const data = new FormData(form);
        const token = String(data.get('cf-turnstile-response') || '').trim();
        const note = form.querySelector('[data-contact-form-note]');
        const submitButton = form.querySelector('button[type="submit"]');

        const showNote = (message) => {
          if (!(note instanceof HTMLElement)) return;
          note.textContent = message;
          note.removeAttribute('hidden');
        };

        if (!token) {
          showNote('Please complete the verification before sending.');
          return;
        }

        if (note instanceof HTMLElement) note.setAttribute('hidden', '');
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        fetch(form.action, {
          method: 'POST',
          body: data,
          headers: {
            Accept: 'application/json',
          },
        })
          .then((response) => {
            if (!response.ok) throw new Error('Submission failed');
            form.reset();
            showNote('Thank you. Your inquiry has been sent.');
            const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
            turnstile?.reset();
          })
          .catch(() => {
            showNote('Something went wrong. Please try again in a moment.');
          })
          .finally(() => {
            if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
          });
      });

      const carousel = document.querySelector('[data-album-carousel]');
      const lightbox = document.querySelector('[data-lightbox]');

      if (carousel) {
        const panels = Array.from(carousel.querySelectorAll('[data-album-panel]'));
        const dots = Array.from(carousel.querySelectorAll('[data-album-dot]'));
        const previous = carousel.querySelector('[data-album-prev]');
        const next = carousel.querySelector('[data-album-next]');
        const swipeArea = carousel.querySelector('.albums');
        let activeIndex = 0;
        let touchStartX = 0;

        const showAlbum = (index) => {
          activeIndex = (index + panels.length) % panels.length;

          panels.forEach((panel, panelIndex) => {
            const isActive = panelIndex === activeIndex;
            panel.classList.toggle('active', isActive);
            panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          });

          dots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === activeIndex;
            dot.classList.toggle('active', isActive);
            dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
        };

        previous?.addEventListener('click', () => showAlbum(activeIndex - 1));
        next?.addEventListener('click', () => showAlbum(activeIndex + 1));
        dots.forEach((dot, index) => dot.addEventListener('click', () => showAlbum(index)));

        swipeArea?.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') showAlbum(activeIndex - 1);
          if (event.key === 'ArrowRight') showAlbum(activeIndex + 1);
        });

        swipeArea?.addEventListener('touchstart', (event) => {
          touchStartX = event.touches[0]?.clientX ?? 0;
        }, { passive: true });

        swipeArea?.addEventListener('touchend', (event) => {
          const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
          const distance = touchEndX - touchStartX;

          if (Math.abs(distance) < 45) return;
          showAlbum(distance > 0 ? activeIndex - 1 : activeIndex + 1);
        });
      }

      if (lightbox) {
        const triggers = Array.from(document.querySelectorAll('[data-lightbox-trigger]'));
        const image = lightbox.querySelector('[data-lightbox-image]');
        const caption = lightbox.querySelector('[data-lightbox-caption]');
        const closeButton = lightbox.querySelector('[data-lightbox-close]');
        const previousButton = lightbox.querySelector('[data-lightbox-prev]');
        const nextButton = lightbox.querySelector('[data-lightbox-next]');
        const albums = triggers.reduce((groups, trigger) => {
          const album = trigger.dataset.lightboxAlbum;
          if (!groups[album]) groups[album] = [];
          groups[album].push(trigger);
          return groups;
        }, {});
        let activeAlbum = '0';
        let activeImage = 0;
        let lightboxTouchStartX = 0;

        const renderPreview = () => {
          const album = albums[activeAlbum] ?? [];
          const trigger = album[activeImage];
          if (!trigger || !image || !caption) return;

          const title = trigger.dataset.lightboxTitle ?? 'Album';
          image.src = trigger.dataset.lightboxSrc ?? '';
          image.alt = `${title} photograph ${activeImage + 1}`;
          caption.textContent = `${title} / ${activeImage + 1} of ${album.length}`;
        };

        const openPreview = (trigger) => {
          activeAlbum = trigger.dataset.lightboxAlbum ?? '0';
          activeImage = Number(trigger.dataset.lightboxIndex ?? 0);
          renderPreview();
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.classList.add('preview-open');
          closeButton?.focus();
        };

        const closePreview = () => {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('preview-open');
        };

        const showPreview = (offset) => {
          const album = albums[activeAlbum] ?? [];
          activeImage = (activeImage + offset + album.length) % album.length;
          renderPreview();
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => openPreview(trigger));
        });

        closeButton?.addEventListener('click', closePreview);
        previousButton?.addEventListener('click', () => showPreview(-1));
        nextButton?.addEventListener('click', () => showPreview(1));

        lightbox.addEventListener('click', (event) => {
          const target = event.target;
          const clickedImage = target === image;
          const clickedControl = target instanceof Element && target.closest('button');

          if (!clickedImage && !clickedControl) closePreview();
        });

        lightbox.addEventListener('touchstart', (event) => {
          lightboxTouchStartX = event.touches[0]?.clientX ?? 0;
        }, { passive: true });

        lightbox.addEventListener('touchend', (event) => {
          const touchEndX = event.changedTouches[0]?.clientX ?? lightboxTouchStartX;
          const distance = touchEndX - lightboxTouchStartX;

          if (Math.abs(distance) < 45) return;
          showPreview(distance > 0 ? -1 : 1);
        });

        document.addEventListener('keydown', (event) => {
          if (!lightbox.classList.contains('open')) return;
          if (event.key === 'Escape') closePreview();
          if (event.key === 'ArrowLeft') showPreview(-1);
          if (event.key === 'ArrowRight') showPreview(1);
        });
      }

      const focusWheel = document.querySelector('[data-focus-wheel]');

      if (focusWheel) {
        const updateFocusWheel = () => {
          const rect = focusWheel.getBoundingClientRect();
          const viewportHeight = window.innerHeight || 1;
          const progress = 1 - ((rect.top + rect.height / 2) / viewportHeight);
          const clampedProgress = Math.min(1, Math.max(0, progress));
          focusWheel.style.setProperty('--focus-progress', clampedProgress.toString());
        };

        updateFocusWheel();
        window.addEventListener('scroll', updateFocusWheel, { passive: true });
        window.addEventListener('resize', updateFocusWheel);
      }
    </script>
  </body>
</html>
