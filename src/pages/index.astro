---
import '../styles/global.css';

const albums = [
  {
    title: 'First Light',
    slug: 'first-light',
    description: 'Quiet textures, old walls, and details shaped by natural light.',
    folder: 'album1',
    photos: [
      '545231903_17957342184003956_1496422976014836905_n.jpg',
      '542865988_17957342607003956_4305994197225772454_n.jpg',
      '546523041_17957342757003956_2372337750703247383_n.jpg',
      '544123387_17957342838003956_7079444052374342043_n.jpg',
    ],
  },
  {
    title: 'Still Roads',
    slug: 'still-roads',
    description: 'A softer passage through places, pauses, and small discoveries.',
    folder: 'album1',
    photos: [
      '544823803_17957343063003956_3198052180525970656_n.jpg',
      '544844732_17957343321003956_6179681169613150223_n.jpg',
      '544145230_17957343375003956_5933756572986482124_n.jpg',
      '546571339_17957343453003956_6976260187363928964_n.jpg',
    ],
  },
  {
    title: 'Green Hours',
    slug: 'green-hours',
    description: "Nature-led frames with a calm palette and an explorer's rhythm.",
    folder: 'album1',
    photos: [
      '544995829_17957343621003956_1516659409349310951_n.jpg',
      '545351514_17957344248003956_4273194522779784991_n.jpg',
      '544089634_17957344473003956_5163365635602737228_n.jpg',
      '543984369_17957345421003956_262576140533256651_n.jpg',
    ],
  },
];

const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Daleria Xplorelens photography portfolio: quiet stories, natural light, and cinematic travel frames."
    />
    <title>Daleria Xplorelens | Photography</title>
  </head>
  <body>
    <header class="site-header" aria-label="Main navigation">
      <a class="brand" href="#top">Daleria Xplorelens</a>
      <nav>
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Travel / Nature / Moments</p>
          <h1 id="hero-title">Photography for places that stay with you.</h1>
          <p class="hero-text">
            A calm visual archive of landscapes, details, and fleeting light, composed
            with an explorer's eye and an editorial sense of restraint.
          </p>
          <a class="button" href="#work">View selected work</a>
        </div>
        <figure class="hero-image">
          <img
            src={asset('images/album1/545231903_17957342184003956_1496422976014836905_n.jpg')}
            alt="Featured photograph by Daleria Xplorelens"
          />
        </figure>
      </section>

      <section class="intro" aria-label="Portfolio introduction">
        <p>
          Quiet colors, strong compositions, and a sense of discovery. This portfolio
          is designed to keep the interface restrained so the photographs can carry
          the atmosphere.
        </p>
      </section>

      <section id="work" class="work" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow">Selected Work</p>
          <h2 id="work-title">Albums</h2>
        </div>

        <div class="album-shell" data-album-carousel>
          <div class="album-controls" aria-label="Album controls">
            <button class="album-arrow" type="button" data-album-prev aria-label="Previous album">&larr;</button>
            <div class="album-dots" role="tablist" aria-label="Choose album">
              {albums.map((album, index) => (
                <button
                  class:list={['album-dot', index === 0 && 'active']}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={album.slug}
                  data-album-dot={index}
                >
                  {album.title}
                </button>
              ))}
            </div>
            <button class="album-arrow" type="button" data-album-next aria-label="Next album">&rarr;</button>
          </div>

          <div class="albums" tabindex="0" aria-live="polite">
            {albums.map((album, albumIndex) => (
              <article class:list={['album', albumIndex === 0 && 'active']} id={album.slug} data-album-panel={albumIndex} aria-hidden={albumIndex === 0 ? 'false' : 'true'}>
              <div class="album-heading">
                <div>
                  <p class="eyebrow">{album.photos.length} photographs</p>
                  <h3>{album.title}</h3>
                </div>
                <p>{album.description}</p>
              </div>

              <div class="gallery">
                {album.photos.map((photo, index) => (
                  <a
                    class:list={['gallery-item', index % 5 === 0 && 'wide', index % 7 === 0 && 'tall']}
                    href={asset(`images/${album.folder}/${photo}`)}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <img src={asset(`images/${album.folder}/${photo}`)} alt={`${album.title} photograph ${index + 1}`} loading={index < 3 ? 'eager' : 'lazy'} />
                  </a>
                ))}
              </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="about" aria-labelledby="about-title">
        <figure>
          <img src={asset('images/profile_pic.jpg')} alt="Portrait of Daleria Xplorelens" loading="lazy" />
        </figure>
        <div>
          <p class="eyebrow">Behind the Lens</p>
          <h2 id="about-title">A patient eye for natural stories.</h2>
          <p>
            Daleria Xplorelens creates photographs with a soft, observant rhythm:
            landscapes, details, and travel memories shaped by light, texture, and
            place. This section can later become her final bio, services, exhibitions,
            or booking information.
          </p>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">For projects, prints, and collaborations.</h2>
        <div class="contact-actions">
          <a class="button" href="https://www.instagram.com/daleria_xplorelens/" target="_blank" rel="noreferrer">
            Instagram
          </a>
          <a class="button secondary" href="mailto:hello@example.com">Email</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Daleria Xplorelens</p>
    </footer>
    <script>
      const carousel = document.querySelector('[data-album-carousel]');

      if (carousel) {
        const panels = Array.from(carousel.querySelectorAll('[data-album-panel]'));
        const dots = Array.from(carousel.querySelectorAll('[data-album-dot]'));
        const previous = carousel.querySelector('[data-album-prev]');
        const next = carousel.querySelector('[data-album-next]');
        const swipeArea = carousel.querySelector('.albums');
        let activeIndex = 0;
        let touchStartX = 0;

        const showAlbum = (index) => {
          activeIndex = (index + panels.length) % panels.length;

          panels.forEach((panel, panelIndex) => {
            const isActive = panelIndex === activeIndex;
            panel.classList.toggle('active', isActive);
            panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          });

          dots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === activeIndex;
            dot.classList.toggle('active', isActive);
            dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
        };

        previous?.addEventListener('click', () => showAlbum(activeIndex - 1));
        next?.addEventListener('click', () => showAlbum(activeIndex + 1));
        dots.forEach((dot, index) => dot.addEventListener('click', () => showAlbum(index)));

        swipeArea?.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') showAlbum(activeIndex - 1);
          if (event.key === 'ArrowRight') showAlbum(activeIndex + 1);
        });

        swipeArea?.addEventListener('touchstart', (event) => {
          touchStartX = event.touches[0]?.clientX ?? 0;
        }, { passive: true });

        swipeArea?.addEventListener('touchend', (event) => {
          const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
          const distance = touchEndX - touchStartX;

          if (Math.abs(distance) < 45) return;
          showAlbum(distance > 0 ? activeIndex - 1 : activeIndex + 1);
        });
      }
    </script>
  </body>
</html>
