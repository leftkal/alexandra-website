---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteUrl } from '../utils/url';

const entry = await getEntry('copyright', 'image-use');
if (!entry) throw new Error('Copyright content is missing.');

const { Content } = await render(entry);
const content = entry.data;
const siteUrl = getSiteUrl();
const canonical = `${siteUrl}/copyright/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  name: content.title,
  description: content.description,
  url: canonical,
  copyrightHolder: {
    '@type': 'Person',
    name: content.copyrightHolder,
  },
  copyrightNotice: `© ${new Date().getFullYear()} ${content.copyrightHolder}. All rights reserved.`,
  usageInfo: content.usageTerms,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Alexandra Maria Deli',
    url: siteUrl,
  },
};
---

<BaseLayout title={`${content.title} | Alexandra Maria Deli`} description={content.description} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <header class="site-header">
    <a class="brand" href="/">Alexandra Maria Deli</a>
    <nav>
      <a href="/">Home</a>
      <a href="/#work">Albums</a>
      <a href="/#about">About</a>
      <a href="/guides/">Guides</a>
      <a href="/#contact">Contact</a>
    </nav>
  </header>

  <main class="policy-page">
    <section class="policy-hero" aria-labelledby="policy-title">
      <p class="eyebrow">Copyright</p>
      <h1 id="policy-title">{content.title}</h1>
      <p>{content.intro}</p>
    </section>

    <article class="policy-content">
      <Content />
    </article>
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} Alexandra Maria Deli &middot; <a href="/copyright/">Image use &amp; copyright</a></p>
  </footer>
</BaseLayout>

<style>
  .policy-page {
    max-width: var(--content-width);
  }

  .policy-hero,
  .policy-content {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 4vw, 3rem);
  }

  .policy-hero {
    border-bottom: 1px solid var(--color-light-gray);
    max-width: 68rem;
  }

  .policy-hero p:not(.eyebrow),
  .policy-content {
    color: color-mix(in srgb, var(--color-charcoal) 76%, var(--color-mid-gray));
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.75;
  }

  .policy-hero p:not(.eyebrow) {
    margin: 1.25rem 0 0;
    max-width: 44rem;
  }

  .policy-content {
    max-width: 48rem;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .policy-content :global(h2) {
    color: var(--color-charcoal);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 2.25rem 0 0.75rem;
  }

  .policy-content :global(h2:first-child) {
    margin-top: 0;
  }
</style>
