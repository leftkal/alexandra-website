---
import '../styles/global.css';
import { getAbsoluteImageUrl } from '../utils/url';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  imagePath?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, canonical, imagePath, ogTitle, ogDescription } = Astro.props;
const defaultImagePath = 'images/cms/presence-behind-the-door-R1-00324-0018.jpg';
const ogImage = imagePath ? getAbsoluteImageUrl(imagePath) : getAbsoluteImageUrl(defaultImagePath);
const ogTitleFinal = ogTitle || title;
const ogDescFinal = ogDescription || description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={ogTitleFinal} />
    <meta property="og:description" content={ogDescFinal} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Photograph by Alexandra Maria Deli" />
    <meta property="og:site_name" content="Alexandra Maria Deli" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleFinal} />
    <meta name="twitter:description" content={ogDescFinal} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
