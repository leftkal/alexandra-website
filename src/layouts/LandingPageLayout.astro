---
import BaseLayout from './BaseLayout.astro';
import Schema from '../components/Schema.astro';
import { getSiteUrl } from '../utils/url';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  slug: string;
  schemaType: 'Photographer' | 'LocalBusiness';
  keyword: string;
  imagePath?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, canonical, slug, schemaType, keyword, imagePath, ogTitle, ogDescription } = Astro.props;
const siteUrl = getSiteUrl();
const schemaImagePath = imagePath || 'images/album1/545231903_17957342184003956_1496422976014836905_n.jpg';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  imagePath={imagePath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <Schema
    pageTitle={title}
    pageDescription={description}
    imagePath={schemaImagePath}
    slug={slug}
    schemaType={schemaType}
    keyword={keyword}
  />

  <header class="site-header">
      <a class="brand" href="/">Alexandra Maria Deli</a>
    <nav>
      <a href="/">Home</a>
      <a href="/#work">Albums</a>
      <a href="/#about">About</a>
      <a href="/guides/">Guides</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} Alexandra Maria Deli &middot; <a href="/">alexandra-maria-deli.gr</a></p>
  </footer>
</BaseLayout>
