---
export interface Props {
  heading: string;
  text?: string;
}

const { heading, text = 'For projects, prints, and collaborations in Athens and beyond.' } = Astro.props;
---

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<section id="contact" class="landing-contact" aria-labelledby="landing-contact-title">
  <div class="landing-contact-copy">
    <p class="eyebrow">Contact</p>
    <h2 id="landing-contact-title">{text}</h2>
    <p>Share a few details about the project, location, and timing.</p>
    <a class="button secondary" href="https://www.instagram.com/daleria_xplorelens/" target="_blank" rel="noreferrer nofollow">Instagram</a>
  </div>
  <form class="landing-contact-form" action="https://turnstile-worker.leftkal.workers.dev" method="POST" data-contact-form>
    <input type="hidden" name="_subject" value="Photography inquiry from alexandra-maria-deli.gr" />
    <label>
      Name
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      Contact email
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      Project
      <textarea name="message" rows="5" required>{heading}</textarea>
    </label>
    <div class="cf-turnstile" data-sitekey="0x4AAAAAADmmpbZjPtxnJITb"></div>
    <p class="landing-contact-note" data-contact-form-note hidden>Please complete the verification before sending.</p>
    <button class="button" type="submit">Send inquiry</button>
  </form>
</section>

<script>
  const contactForm = document.querySelector('[data-contact-form]');

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    const token = String(data.get('cf-turnstile-response') || '').trim();
    const note = form.querySelector('[data-contact-form-note]');
    const submitButton = form.querySelector('button[type="submit"]');

    const showNote = (message) => {
      if (!(note instanceof HTMLElement)) return;
      note.textContent = message;
      note.removeAttribute('hidden');
    };

    if (!token) {
      showNote('Please complete the verification before sending.');
      return;
    }

    if (note instanceof HTMLElement) note.setAttribute('hidden', '');
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

    fetch(form.action, {
      method: 'POST',
      body: data,
      headers: {
        Accept: 'application/json',
      },
    })
      .then((response) => {
        if (!response.ok) throw new Error('Submission failed');
        form.reset();
        showNote('Thank you. Your inquiry has been sent.');
        const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
        turnstile?.reset();
      })
      .catch(() => {
        showNote('Something went wrong. Please try again in a moment.');
      })
      .finally(() => {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      });
  });
</script>

<style>
  .landing-contact {
    align-items: stretch;
    background: var(--color-deep-green);
    border-radius: calc(var(--image-radius) * 1.6);
    color: var(--color-white);
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    max-width: calc(var(--content-width) - 6rem);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .landing-contact-copy {
    align-self: center;
  }

  .landing-contact .eyebrow {
    color: var(--color-light-gray);
  }

  .landing-contact h2 {
    max-width: 54rem;
  }

  .landing-contact-copy p:not(.eyebrow) {
    color: rgba(248, 248, 245, 0.74);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    margin: 1.2rem 0 1.6rem;
    max-width: 34rem;
  }

  .landing-contact-form {
    background: rgba(248, 248, 245, 0.08);
    border: 1px solid rgba(248, 248, 245, 0.18);
    border-radius: calc(var(--image-radius) * 1.35);
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .landing-contact-form label {
    color: rgba(248, 248, 245, 0.78);
    display: grid;
    font-size: 0.72rem;
    font-weight: 700;
    gap: 0.45rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .landing-contact-form input,
  .landing-contact-form textarea {
    background: rgba(248, 248, 245, 0.94);
    border: 1px solid transparent;
    border-radius: calc(var(--image-radius) * 0.8);
    color: var(--color-charcoal);
    font: inherit;
    letter-spacing: 0;
    padding: 0.9rem 1rem;
    text-transform: none;
    width: 100%;
  }

  .landing-contact-form textarea {
    resize: vertical;
  }

  .landing-contact-form input:focus,
  .landing-contact-form textarea:focus {
    border-color: var(--color-light-gray);
    outline: 2px solid rgba(248, 248, 245, 0.32);
    outline-offset: 2px;
  }

  .landing-contact-form .button {
    justify-content: center;
    padding-block: 0.7rem;
    width: 100%;
  }

  .landing-contact-note {
    color: rgba(248, 248, 245, 0.78);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: -0.25rem 0 0;
  }

  .landing-contact-note[hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .landing-contact {
      grid-template-columns: 1fr;
    }
  }
</style>
