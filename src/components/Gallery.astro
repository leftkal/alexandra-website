---
import { getImageUrl } from '../utils/url';

export interface GalleryImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

export interface Props {
  images: GalleryImage[];
  title?: string;
}

const { images, title = 'Selected Work' } = Astro.props;
---

<section class="landing-gallery" aria-labelledby="landing-gallery-title">
  <div class="section-heading">
    <p class="eyebrow">Portfolio</p>
    <h2 id="landing-gallery-title">{title}</h2>
  </div>

  {images.length > 0 && (
    <div class="landing-gallery-grid">
      {images.map((img, index) => (
        <figure class="landing-gallery-figure">
          <span class="frame-number">0{index + 1}</span>
          <img src={getImageUrl(img.src)} alt={img.alt} loading="lazy" width={img.width || 800} height={img.height || 1000} />
        </figure>
      ))}
    </div>
  )}

  <p class="landing-gallery-note">
    View the full portfolio on the <a href="/">homepage</a>, or browse selected
    <a href="/#work">albums</a> directly.
  </p>

  <div class="landing-gallery-links">
    <a class="button" href="/">Visit portfolio</a>
    <a class="button secondary" href="/#work">Browse albums</a>
  </div>
</section>

<style>
  .landing-gallery {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem);
  }

  .landing-gallery .section-heading {
    border-top: 1px solid var(--color-light-gray);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .landing-gallery-grid {
    background: var(--color-charcoal);
    border-radius: calc(var(--image-radius) * 1.6);
    box-shadow: 0 1.8rem 4rem rgba(38, 42, 37, 0.14);
    display: grid;
    gap: clamp(0.75rem, 1.6vw, 1rem);
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    padding: clamp(0.85rem, 2vw, 1.4rem);
    position: relative;
  }

  .landing-gallery-grid::before,
  .landing-gallery-grid::after {
    background-image: repeating-linear-gradient(90deg, rgba(248, 248, 245, 0.72) 0 0.7rem, transparent 0.7rem 1.25rem);
    content: "";
    height: 0.65rem;
    left: 0;
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .landing-gallery-grid::before {
    top: 0.45rem;
  }

  .landing-gallery-grid::after {
    bottom: 0.45rem;
  }

  .landing-gallery-figure:nth-child(2) {
    transform: translateY(clamp(0.5rem, 1vw, 0.9rem));
  }

  .landing-gallery-figure {
    background: #11140f;
    border: 1px solid rgba(248, 248, 245, 0.16);
    border-radius: calc(var(--image-radius) * 0.75);
    box-shadow: none;
    margin: 0;
    overflow: hidden;
    padding: 1.2rem 0.55rem 1.75rem;
    position: relative;
  }

  .frame-number {
    bottom: 0.45rem;
    color: rgba(248, 248, 245, 0.62);
    font-size: 0.62rem;
    font-weight: 700;
    left: 0.6rem;
    letter-spacing: 0.14em;
    position: absolute;
    z-index: 1;
  }

  .landing-gallery-figure img {
    display: block;
    filter: grayscale(0.12) saturate(0.86) contrast(1.04);
    height: auto;
    object-fit: cover;
    transition: scale 500ms ease;
    width: 100%;
  }

  .landing-gallery-figure:hover img {
    scale: 1.035;
  }

  .landing-gallery-note {
    color: color-mix(in srgb, var(--color-charcoal) 78%, var(--color-mid-gray));
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    margin: 0 0 1.6rem;
  }

  .landing-gallery-note a {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .landing-gallery-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .landing-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .landing-gallery-grid {
      grid-template-columns: 1fr;
    }

    .landing-gallery-figure:nth-child(2) {
      transform: none;
    }
  }
</style>
