---
import { getImageUrl, getWebpImageUrl } from '../utils/url';

export interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading,
  fetchpriority,
  class: className,
} = Astro.props;

const imageUrl = getImageUrl(src);
const webpUrl = getWebpImageUrl(src);
---

{webpUrl ? (
  <picture>
    <source srcset={webpUrl} type="image/webp" />
    <img src={imageUrl} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} class={className} />
  </picture>
) : (
  <img src={imageUrl} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} class={className} />
)}
