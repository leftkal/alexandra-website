---
import { getPageUrl } from '../utils/url';
import { landingPages } from '../content/landing-pages';

export interface Props {
  slugs: string[];
  title?: string;
}

const { slugs, title = 'Related Services' } = Astro.props;

const related = landingPages.filter((p) => slugs.includes(p.slug));
---

{related.length > 0 && (
  <section class="related-pages" aria-labelledby="related-title">
    <div class="section-heading">
      <p class="eyebrow">Explore</p>
      <h2 id="related-title">{title}</h2>
    </div>

    <div class="related-grid">
      {related.map((p) => (
        <a class="related-card" href={getPageUrl(p.slug)}>
          <h3 class="related-card-title">{p.title}</h3>
          <p class="related-card-desc">{p.metaDescription}</p>
          <span class="related-card-link">Learn more &rarr;</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-pages {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem);
  }

  .related-pages .section-heading {
    border-top: 1px solid var(--color-light-gray);
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .related-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }

  .related-card {
    background: linear-gradient(180deg, rgba(248, 248, 245, 0.86), rgba(239, 239, 232, 0.62));
    border: 1px solid rgba(216, 218, 211, 0.92);
    border-radius: calc(var(--image-radius) * 1.3);
    box-shadow: 0 1rem 2.5rem rgba(38, 42, 37, 0.05);
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    padding: 1.6rem;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .related-card:hover {
    background: var(--color-off-white);
    border-color: var(--color-green);
    transform: translateY(-3px);
  }

  .related-card-title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.12;
    margin: 0 0 0.75rem;
  }

  .related-card-desc {
    color: color-mix(in srgb, var(--color-charcoal) 72%, var(--color-mid-gray));
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .related-card-link {
    color: var(--color-green);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-top: auto;
  }
</style>
